# Default values
defaults
auth			on
tls				on
tls_trust_file	/etc/ssl/certs/ca-certificates.crt
logfile			~/.config/mutt/msmtp.log

# Gmail
account			gmail
host			smtp.gmail.com
port			587
protocol		smtp
user			tonygreen2655@gmail.com
from			tonygreen2655@gmail.com
passwordeval	"kwallet-query -f passwords -r imapGmail kdewallet"

